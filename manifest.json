{
  "manifest_version": 3,
  "name": "Orbit \u2014 LinkedIn Network Mapper",
  "version": "2.1.0",
  "description": "Build a local, evidence-backed connection graph from LinkedIn pages you can view.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Orbit network mapper"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": "",
  "externally_connectable": {
    "matches": [
      "https://orbit-shreev2703-graph-test.shreev2703.chatgpt.site/*"
    ]
  }
}
