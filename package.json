{
  "name": "warm-path",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "npm run build:server && node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node --watch dist/packages/server/main.js",
    "typecheck": "npm run typecheck:web && npm run typecheck:server",
    "typecheck:web": "tsc -p tsconfig.json",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:graph": "tsc -p tsconfig.graph.json",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "npm run typecheck:web && vite build",
    "preview": "vite preview",
    "test": "npm run build:server && node --test tests/*.test.mjs",
    "check:integration": "npm run typecheck && npm run typecheck:graph && npm test"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
